<article class="card">
    <a class="card-link" href="{{ path('listing', {'id': annonce.id}) }}">
        <img src="{{ annonce.img|e }}" alt="Image de l'annonce" />
        <div>
            <h3 class="title">{{ annonce.title|e }}</h3>
            <h4>
                {{ annonce.price|e }}
                {{ annonce.transaction == 'Rent' ? '€/mois' : '€' }}
            </h4>
            <p class="capitalize">{{ annonce.city|e }}, FRANCE</p>
            <p class="description">{{ annonce.description|e }}</p>
            <p class="property">
                {{ annonce.property == 'House' ? 'Maison' : 'Appartement' }}
            </p>
        </div>
    </a>

    {% set annonceId = annonce.id %}
    {% set isFavorited = userId ? (annonceId in favorites) : false %}

    {% include '_Partials/_favorite-button.html.twig' with {
    annonceId: annonceId,
    isFavorited: isFavorited
    } %}

    <a class="contact contact-btn"
        href="https://inspirationfeed.com/wp-content/uploads/2022/12/Hello-memes11-350x250.jpg">Contact</a>
</article>