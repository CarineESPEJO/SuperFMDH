<header>
    <nav>
        <div>
            <a href="{{ path('home')}}">
                <img src=" {{asset('images/logo_big.PNG')}}" alt="Logo">
                <b>Find My Dream Home</b>
            </a>
        </div>

        {% if isLoggedIn %}
        <p>Bonjour {{ userEmail|e }}</p>
        {% endif %}

        <ul>
            <li><a href="{{ path('houses')}}">Maisons</a></li>
            <li><a href="{{ path('apartments')}}">Apartements</a></li>
            <li><a href="{{ path('search')}}">Rechercher</a></li>
            {% if isLoggedIn %}
            <li><a href="{{ path('favorites')}}">Favoris</a></li>
            {% endif %}
            {% if userRole in ['admin', 'agent'] %}
            <li class="login"><a href="{{ path('createlisting')}}">Ajouter</a></li>
            {% endif %}
            {% if isLoggedIn %}
            <li class="login"><a href="{{ path('logout')}}">Deconnexion</a></li>
            {% else %}
            <li class="login"><a href="{{ path('login')}}">Connexion</a></li>
            {% endif %}
        </ul>
    </nav>
</header>