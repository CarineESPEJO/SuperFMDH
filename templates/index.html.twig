{% extends 'base.html.twig' %}
{% block title %}Find My Dream Home - Annonces Immobilières{% endblock %}
{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('build/catalogs.css') }}">
{% endblock %}


{% block body %}
<main>
    <section>
        <h2>Nos annonces de maisons</h2>
        <hr>
        <div class="listings-grid">
            {% for listing in houses %}
            {% include '_partials/_card.html.twig' with {
            listing: listing,
            favoriteIds: favoriteIds,
            userId: userId,
            isLoggedIn: isLoggedIn,
            userEmail: userEmail,
            } %}
            {% else %}
            <p>Aucune annonce trouvée.</p>
            {% endfor %}
        </div>
    </section>

    <section>
        <h2>Nos annonces d'appartements</h2>
        <hr>
        <div class="listings-grid">
            {% for listing in apartments %}
            {% include '_partials/_card.html.twig' with {
            listing: listing,
            favoriteIds: favoriteIds,
            userId: userId,
            isLoggedIn: isLoggedIn,
            userEmail: userEmail,
            } %}
            {% else %}
            <p>Aucune annonce trouvée.</p>
            {% endfor %}
        </div>
    </section>
</main>
{% endblock %}