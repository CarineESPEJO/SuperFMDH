{% extends 'base.html.twig' %}
{% block title %}Find My Dream Home - Inscription{% endblock %}
{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/forms.css') }}">
{% endblock %}

{% block body %}
<div class="body-wrapper">
    <aside>
        <img src="{{ asset('images/login_img.jpeg') }}" alt="Login visual">
    </aside>

    <div class="main-wrapper">
        <main>
            <h2>
                Inscription à <br><b>Find My Dream Home</b>
            </h2>

            {% if isLoggedIn %}
            <p>Vous êtes déjà connecté.</p>
            {% else %}
            {% if account_created %}
            <h3 style="color: green;">Votre compte a été créé avec succès</h3>
            {% endif %}

            {% if errors.general is defined %}
            <p style="color: red;">
                {{ errors.general }}
            </p>
            {% endif %}

            <form method="POST">
                <label for="email">Email :</label>
                <input type="email" id="email" name="email" required
                    value="{{ app.request.request.get('email')|default('') }}">
                <span style="color:red;">
                    {{ errors.email ?? '' }}
                </span>

                <label for="password">Mot de passe :</label>
                <input type="password" id="password" name="password" minlength="9" required>
                <span style="color:red;">
                    {{ errors.password ?? '' }}
                </span>

                <label for="confirm_password">Confirmer le mot de passe :</label>
                <input type="password" id="confirm_password" name="confirm_password" minlength="9" required>
                <span style="color:red;">
                    {{ errors.confirm_password ?? '' }}
                </span>

                <button type="submit">S'inscrire</button>
            </form>
            {% endif %}

            <a href="{{ path('login') }}">Déjà inscrit ? Connectez-vous</a>
            {% endif %}
        </main>
    </div>
</div>
{% endblock %}