<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}My Symfony App{% endblock %}</title>

    {# CSRF token for Stimulus controller #}
    <meta name="csrf-token" content="{{ csrf_token('authenticate') }}">

    {% block stylesheets %}
    {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
    {{ encore_entry_script_tags('app') }}
    {% endblock %}

</head>

<body>
    {% include '_partials/_header.html.twig' %}

    {% for label, messages in app.flashes %}
    <div class="flash flash-{{ label }}">
        <span class="close"
            onclick="this.parentElement.style.opacity='0'; setTimeout(()=>this.parentElement.remove(),500)">×</span>
        {% for message in messages %}
        <p>{{ message }}</p>
        {% endfor %}
    </div>
    {% endfor %}



    {% block body %}{% endblock %}

    <script>
        setTimeout(() => {
            document.querySelectorAll('.flash').forEach(flash => {
                flash.style.opacity = '0';
                setTimeout(() => flash.remove(), 500);
            });
        }, 5000); // 5 seconds
    </script>

</body>

</html>