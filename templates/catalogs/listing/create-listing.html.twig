{% extends 'base.html.twig' %}
{% block title %}Find My Dream Home - Créer une annonce{% endblock %}
{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/forms.css') }}">
{% endblock %}



{% block body %}
<div class="body-wrapper">
    <aside>
        <img src=" {{asset('images/login_img.jpeg')}}" alt="Login visual">
    </aside>

    <div class="main-wrapper">
        <main>
            <h2>
                Créer une annonce sur <br><b>Find My Dream Home</b>
            </h2>

            {% if isLoggedIn && userRole in ['admin', 'agent'] %}
            {% if errors.general is defined %}
            <p style="color: red;">
                {{ errors.general }}
            </p>
            {% endif %}

            <form method="POST">
                <label for="email">Email:</label>
                <input type="email" name="email" id="email" required>
                <span style="color:red;">
                    {{ errors.email ?? '' }}
                </span>

                <label for="password">Mot de passe:</label>
                <input type="password" name="password" id="password" required>
                <span style="color:red;">
                    {{ errors.password ?? '' }}
                </span>


                <button type="submit">Connexion</button>
            </form>

            {% else %}
            <p>Vous devez être connecté .</p>

            {% endif %}

            <a href="{{ path('registration')}}">Pas encore inscrit ? Inscrivez-vous</a>
        </main>
    </div>
</div>
{% endblock %}